# Point.ai — Environment Variables
# Copy to .env and fill in values

# Inference backend: heuristic_local (CPU, no models needed)
POINTAI_INFERENCE_BACKEND=heuristic_local

# CORS: comma-separated allowed origins
# For production, set to your Railway domain
# POINTAI_CORS_ORIGINS=https://pointai-production.up.railway.app

# Supabase (frontend needs these as VITE_ prefixed)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
